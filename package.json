{
  "name": "fichator",
  "productName": "Fichator 3000",
  "version": "1.0.0",
  "description": "Générateur de fiches mise en place & banquets — Chez le Père Gras",
  "author": "TL Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "open src/index.html || xdg-open src/index.html",
    "dist": "electron-builder --win --publish never",
    "release": "npm version patch -m \"Version %s\" && git push",
    "release:minor": "npm version minor -m \"Version %s\" && git push"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.tlstudio.fichator",
    "productName": "Fichator 3000",
    "copyright": "TL Studio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Fichator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fichator 3000",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "6bz2tt5244-crypto",
        "repo": "fichator",
        "releaseType": "release"
      }
    ]
  }
}
